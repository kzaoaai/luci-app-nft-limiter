{
	"luci-app-nft-limiter": {
		"description": "Grant access for luci-app-nft-limiter",
		"read": {
			"uci": [ "nft-limiter", "firewall" ],
			"file": {
				"/usr/sbin/nft": [ "exec" ],
				"/usr/bin/nft-limiter": [ "exec" ],
				"/sbin/ip": [ "exec" ]
			}
		},
		"write": {
			"uci": [ "nft-limiter" ],
			"file": {
				"/etc/init.d/nft-limiter": [ "exec" ]
			}
		}
	}
}
