#!/bin/sh
# nft-limiter-switch -- turn one rule's block on or off, or set its hours,
# for people who should not have the router's login. A rule takes part only
# when it has a switch name (UCI option switch_id, set in its Edit dialog),
# and that name is the only way to address it here.
#
# Usage: nft-limiter-switch list
#        nft-limiter-switch status <name>
#        nft-limiter-switch on|off <name>
#        nft-limiter-switch hours <name> <HH:MM> <HH:MM>
#        nft-limiter-switch hours <name> allday
#
# Every command prints one JSON object (the rule's state after the command,
# or {"error": ...}), so an iOS Shortcut can read it with "Get Dictionary".
# Both carry "text", the line the Shortcut shows.
# A limited rpcd login is granted exec on this file and nothing else (ACL
# group luci-app-nft-limiter-switch); everything it does is checked here.
#
# A rule is written by a section name of its own, never by its place. uci
# names an unnamed section cfg, its place among the package's sections and
# a hash of its type alone (cfg0a0f15), so that name is a place too: a rule
# deleted or moved above it in LuCI between this command's read and its
# write, or before its commit (which applies staged changes by name), hands
# it to a neighbour, and the write lands there. The first write to a rule
# therefore names it sw_<switch name>; no delete or move changes that.

NAME=nft-limiter
. /lib/functions.sh

_json_str() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

_fail() {
    printf '{"error":"%s","text":"%s"}\n' "$(_json_str "$1")" "$(_json_str "Error: $1")"
    exit 1
}

# _find <switch name> -- read the config once and set $sec to the section
#   name of the first rule with that switch name.
_find_cb() {
    local id
    [ -z "$sec" ] || return 0
    config_get id "$1" switch_id
    [ "$id" = "$want" ] && sec="$1"
}

_find() {
    sec=""; want="$1"
    config_load "$NAME"
    config_foreach _find_cb device
    [ -n "$sec" ]
}

# _own_name -- give the rule in $sec a section name of its own if it has
#   none. The rename itself still goes by the place name, so it can land on
#   a neighbour this once; the rule is then read again by its switch name
#   and must carry the new name, else nothing is written (the neighbour
#   keeps a name nothing reads, and its options are untouched).
_own_name() {
    local base new n=1
    echo "$sec" | grep -qE '^cfg[0-9a-f]{6,}$' || return 0
    base="sw_$(echo "$want" | sed 's/-/_/g')"; new="$base"
    while uci -q get "${NAME}.${new}" >/dev/null; do
        n=$((n + 1)); new="${base}_$n"
    done
    uci -q rename "${NAME}.${sec}=${new}" && uci -q commit "$NAME" \
        || _fail "could not name the rule; try again"
    _find "$want" && [ "$sec" = "$new" ] \
        || _fail "the rules were changed meanwhile; try again"
}

# _set <option>=<value>... -- stage each on the rule by its own name. A rule
#   deleted meanwhile stops the command, and what was staged is dropped.
_set() {
    local kv
    for kv; do
        uci -q set "${NAME}.${sec}.${kv}" && continue
        uci -q revert "${NAME}.${sec}"
        _fail "unknown switch"
    done
}

_mins() {
    echo "$1" | awk -F: '{ print $1 * 60 + $2 }'
}

# _state <section> -- print the rule's state as JSON, from the last read
_state() {
    local s="$1" id label en block ts te week from to allday now day inwin active text
    config_get id "$s" switch_id
    config_get label "$s" comment; [ -n "$label" ] || label="$id"
    config_get en "$s" enable; [ "$en" = 0 ] || en=1
    config_get block "$s" block; [ "$block" = 1 ] || block=0
    config_get ts "$s" timestart; ts=${ts:-00:00}
    config_get te "$s" timeend; te=${te:-00:00}
    # Hours stored before v3.1.11 were checked line by line, so one may hold
    # more than HH:MM; the engine reads that as all day, and so does this.
    _valid_time "$ts" && _valid_time "$te" || { ts=00:00; te=00:00; }
    config_get week "$s" week; week=${week:-0}
    # Equal hours are all day, as the engine reads them.
    allday=false; [ "$ts" = "$te" ] && allday=true

    # In force right now (router clock): enabled, blocking, inside the
    # window (which may run past midnight) and on one of its days.
    inwin=1
    if [ "$allday" = false ]; then
        now=$(( $(date +%H | sed 's/^0//') * 60 + $(date +%M | sed 's/^0//') ))
        from=$(_mins "$ts"); to=$(_mins "$te")
        if [ "$from" -lt "$to" ]; then
            [ "$now" -ge "$from" ] && [ "$now" -lt "$to" ] || inwin=0
        else
            [ "$now" -ge "$from" ] || [ "$now" -lt "$to" ] || inwin=0
        fi
    fi
    day=$(date +%u)
    [ "$week" = 0 ] || case ",$week," in *",$day,"*) ;; *) inwin=0 ;; esac
    active=false; [ "$en" = 1 ] && [ "$block" = 1 ] && [ "$inwin" = 1 ] && active=true

    if [ "$en" = 1 ] && [ "$block" = 1 ]; then
        if [ "$allday" = true ]; then text="$label is blocked all day."
        else text="$label is blocked $ts to $te (allowed $te to $ts)."; fi
        [ "$active" = true ] && text="$text Blocking right now." || text="$text Not blocking right now."
    else
        text="$label is not blocked."
    fi
    printf '{"name":"%s","label":"%s","blocked":%s,"active_now":%s,"from":"%s","to":"%s","allday":%s,"text":"%s"}\n' \
        "$(_json_str "$id")" "$(_json_str "$label")" \
        "$([ "$en" = 1 ] && [ "$block" = 1 ] && echo true || echo false)" "$active" \
        "$ts" "$te" "$allday" "$(_json_str "$text")"
}

_list_cb() {
    local id
    config_get id "$1" switch_id
    [ -n "$id" ] || return 0
    printf '%s' "$sep"; _state "$1" | tr -d '\n'; sep=","
}

_apply() {
    uci commit "$NAME"
    /etc/init.d/nft-limiter reapply >/dev/null 2>&1
}

# A case pattern matches the whole value. grep matches line by line, so a
# value with a newline passed if any one line was valid, and the rest went
# into the nft rules (meta hour "...") as statements of their own.
_valid_time() {
    case "$1" in
        [01][0-9]:[0-5][0-9]|2[0-3]:[0-5][0-9]) return 0 ;;
    esac
    return 1
}

cmd="$1"; name="$2"
case "$cmd" in
    list)
        sep=""; config_load "$NAME"; printf '['
        config_foreach _list_cb device
        printf ']\n'
        exit 0 ;;
    status|on|off|hours) ;;
    *) _fail "usage: list | status <name> | on <name> | off <name> | hours <name> <HH:MM> <HH:MM> | hours <name> allday" ;;
esac

case "$name" in ''|*[!A-Za-z0-9_-]*) _fail "unknown switch" ;; esac
[ "${#name}" -le 32 ] || _fail "unknown switch"
_find "$name" || _fail "unknown switch"

case "$cmd" in
    status)
        _state "$sec"
        exit 0 ;;
    on)
        _own_name
        _set enable=1 block=1 ;;
    off)
        _own_name
        _set block=0 ;;
    hours)
        if [ "$3" = allday ]; then
            from=00:00; to=00:00
        else
            from="$3"; to="$4"
            _valid_time "$from" && _valid_time "$to" || _fail "times must be HH:MM"
            [ "$from" = "$to" ] && _fail "start and end are the same; use allday"
        fi
        _own_name
        _set "timestart=$from" "timeend=$to" ;;
esac
_apply
_find "$name" || _fail "unknown switch"
_state "$sec"
