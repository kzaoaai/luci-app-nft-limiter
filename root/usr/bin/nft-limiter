#!/bin/sh
# nft-limiter - pure nftables traffic shaping engine for OpenWrt 25.12+ / fw4
#
# Supported target formats:
#   Range : 192.168.1.1-192.168.1.200  -> ip daddr/saddr (nftables native)
#   CIDR  : 192.168.1.0/24             -> ip daddr/saddr
#   IP    : 192.168.1.50               -> ip daddr/saddr
#   IPv6  : 2001:db8::5, 2001:db8::/64 -> ip6 daddr/saddr
#   List  : any mix of the above (UCI list, or space-separated) -> one
#           rule per family matching an anonymous set, so every member
#           shares the row's single limit, like a range or subnet does.
#   unreserved : every address in the router's DHCP pools that is not a
#           reserved device's (see _unres_lists). IPv4 only.
#
# Quotas: one counter per rule (all its members together), or with
# 'quota_each 1' one per address (a dynamic set; IPv4 only), so each device
# of a subnet, list or the unreserved target has its own allowance and is
# throttled or blocked on its own once it is used up.
#
# IPv6 coverage for IPv4 hosts: a single-IPv4 target whose MAC is known
# (UCI 'mac', a static DHCP host, the DHCP lease file, or the neighbour
# table) also gets IPv6 rules. Upload matches the MAC; download matches a
# dynamic set of the device's global IPv6 addresses, learned from its own
# outgoing packets (so SLAAC/privacy address changes are followed). The
# IPv4 and IPv6 rules share one named limit, so the device's total rate
# is capped, not each family separately. Ranges and subnets are IPv4-only.
#
# Block: a device with 'block 1' gets plain drop rules (both directions,
# both families) instead of a rate limit, within its schedule if one is set.
#
# Interface scoping: rules match only on user-selected WAN/VPN interfaces
# (meta iifname for download, meta oifname for upload), so LAN-to-LAN
# traffic is never rate-limited.
#
# Commands: start | stop | add <idx> | del <idx> | status | stats |
#           snapshot | history <from|preset> [to]
#   (add/del rebuild the whole chain; kept for compatibility)

. /lib/functions.sh

NAME="nft-limiter"
NFT_TABLE="fw4"
NFT_CHAIN="custom_qos_enforce"
NFT_FILE="/var/run/nft-limiter.nft"
# Table body (objects + chain) that fw4 loads inside its own ruleset
# transaction through the table-post symlink below, so a firewall reload
# never leaves a window without the limiter's rules.
FW4_BODY="/var/run/nft-limiter.fw4.nft"
FW4_LINK="/usr/share/nftables.d/table-post/30-nft-limiter.nft"
# Row index -> row key ("sorted,targets") at the last build, so a rebuild
# can carry each row's counters over even if rows were reordered.
KEYS_FILE="/var/run/nft-limiter.keys"
# Download control mode (UCI "mode"): "shape" (default) queues each rule's
# downloads in its own HTB + fq_codel class; "police" drops what exceeds
# the rate (nft limit). Uploads are always policed: dropped uploads never
# reach the ISP, so they waste no data. In shape mode nft still does all
# the matching (targets, schedules, specificity, quotas) and only tags a
# rule's download packets with a mark in the top byte (TAG_MASK); a clsact
# egress filter on each LAN-side interface sends tagged packets to one IFB
# device, whose HTB tree has a class per tag. Untagged traffic (LAN-to-LAN,
# unlimited rules, rules outside their schedule) never leaves the fast path.
#   tag = rule index + 1 (1-127), its quota throttle = tag + 127,
#   the global default limit = 255.
SHAPE_DEV="ifb-nftl"
TAG_MASK="0xff000000"
TAGS_FILE="/var/run/nft-limiter.tags"     # "<tag> <kbit> <row key>" per class
# Usage history (RAM, tiered) and its flash copy, written once a day and
# at shutdown. See the History section below.
HIST_DIR="/var/run/nft-limiter-hist"
HIST_SAVE="/etc/nft-limiter.hist.tgz"
HIST_FINE_DAYS=7
HIST_HOURLY_DAYS=45
HIST_DAILY_DAYS=400   # default; the "Keep history for (months)" setting overrides
# UTC offset at the last build; the ntp hotplug hook rebuilds on a change.
TZOFF_FILE="/var/run/nft-limiter.tzoff"
# The unreserved target's pools and reserved addresses at the last build;
# "unresync" rebuilds only when they changed.
UNRES_FILE="/var/run/nft-limiter.unres"
OBJ_PREFIX="nftlim_"

_iface_set=""

# -----------------------------------------------------------------------
# _build_iface_set -- read UCI iface option, build nft set string
#   e.g. _iface_set becomes:  "wan", "wg0"
# -----------------------------------------------------------------------
_build_iface_set() {
    local ifaces i dev
    ifaces=$(uci -q get "${NAME}.@${NAME}[0].iface")
    [ -z "$ifaces" ] && ifaces="wan"
    _iface_set=""
    for i in $ifaces; do
        dev=$(ifstatus "$i" 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null)
        [ -z "$dev" ] && dev="$i"
        _iface_set="${_iface_set:+${_iface_set}, }\"${dev}\""
    done
}

# -----------------------------------------------------------------------
# _ip4_to_int <a.b.c.d> -- echo the 32-bit integer value, or return 1 if
#   the argument is not a dotted-quad IPv4 address.
# -----------------------------------------------------------------------
_ip4_to_int() {
    local ip="$1" a b c d o
    case "$ip" in
        *.*.*.*) ;;
        *) return 1 ;;
    esac
    a="${ip%%.*}"; ip="${ip#*.}"
    b="${ip%%.*}"; ip="${ip#*.}"
    c="${ip%%.*}"; ip="${ip#*.}"
    d="$ip"
    for o in "$a" "$b" "$c" "$d"; do
        case "$o" in ''|*[!0-9]*) return 1 ;; esac
        [ "$o" -le 255 ] || return 1
    done
    echo "$(( (a << 24) + (b << 16) + (c << 8) + d ))"
}

# -----------------------------------------------------------------------
# _mbit_to_kb <mbit> -- Mbit/s to whole kbytes/s for nft. A positive rate
#   that would round to 0 becomes 1, since 0 means "no limit" here.
# -----------------------------------------------------------------------
_mbit_to_kb() {
    awk -v v="${1:-0}" 'BEGIN { k = v * 125; if (v > 0 && k < 1) k = 1; printf "%.0f", k }'
}

# _burst <kbytes/s> -- the limit's burst: <rate> x the "burst" setting in
#   seconds (default 2), at least 1 kbyte.
_burst() {
    local b
    b=$(uci -q get "${NAME}.@${NAME}[0].burst")
    awk -v k="$1" -v s="${b:-2}" 'BEGIN { v = k * s; if (v < 1) v = 1; printf "%.0f", v }'
}

# -----------------------------------------------------------------------
# _resolve_mac <ipv4> <uci_mac> -- echo the device's MAC (lowercase), or
#   nothing. Order: the rule's own 'mac' option (set by LuCI on save), a
#   static DHCP host, the dnsmasq lease file, the kernel neighbour table.
# -----------------------------------------------------------------------
_resolve_mac() {
    local ip="$1" mac="$2" sec
    if [ -z "$mac" ]; then
        sec=$(uci -q show dhcp | sed -n "s/^dhcp\.\([^.]*\)\.ip='${ip}'$/\1/p" | head -n1)
        [ -n "$sec" ] && mac=$(uci -q get "dhcp.${sec}.mac" | awk '{print $1}')
    fi
    [ -z "$mac" ] && [ -r /tmp/dhcp.leases ] && \
        mac=$(awk -v ip="$ip" '$3 == ip { print $2; exit }' /tmp/dhcp.leases)
    [ -z "$mac" ] && \
        mac=$(ip -4 neigh show "$ip" 2>/dev/null | awk '{ for (i = 1; i < NF; i++) if ($i == "lladdr") { print $(i+1); exit } }')
    mac=$(echo "$mac" | tr 'A-F' 'a-f')
    case "$mac" in
        [0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]) echo "$mac" ;;
    esac
}

# -----------------------------------------------------------------------
# _target_addr_count <target> -- echo how many addresses the target covers.
#   Used as a specificity sort key: fewer addresses = more specific. So a
#   single host sorts before a subnet, and a tight subnet before a broad
#   one. This lets a per-host rule win over a subnet/range that contains
#   it, regardless of the order the devices appear in UCI (nftables is
#   first-match and the pass-through accept is terminal).
#     single host = 1 ; IPv4 CIDR = 2^(32-prefix) ; range = end-start+1.
#   IPv6 CIDR and anything unparseable fall back to a very large key
#   (treated as least specific, emitted last).
# -----------------------------------------------------------------------
_target_addr_count() {
    local t="$1" s e si ei pfx
    case "$t" in
        unreserved) echo 4294967290 ;;   # after every IPv4 subnet or range
        *-*)   # IPv4 range  start-end
            s="${t%%-*}"; e="${t##*-}"
            si=$(_ip4_to_int "$s") || { echo 4294967296; return; }
            ei=$(_ip4_to_int "$e") || { echo 4294967296; return; }
            [ "$ei" -ge "$si" ] && { echo "$(( ei - si + 1 ))"; return; }
            echo 4294967296 ;;
        */*)   # CIDR (IPv4 or IPv6)
            pfx="${t##*/}"
            case "$t" in
                *:*) echo 4294967295 ;;   # IPv6 CIDR: emit last
                *)
                    case "$pfx" in ''|*[!0-9]*) echo 4294967296; return ;; esac
                    { [ "$pfx" -ge 0 ] && [ "$pfx" -le 32 ]; } || { echo 4294967296; return; }
                    echo "$(( 1 << (32 - pfx) ))" ;;
            esac ;;
        *)     # single host (IPv4 or IPv6)
            echo 1 ;;
    esac
}

# -----------------------------------------------------------------------
# _int_to_ip4 <int> -- dotted quad.
# -----------------------------------------------------------------------
_int_to_ip4() {
    awk -v n="$1" 'BEGIN { printf "%d.%d.%d.%d", int(n / 16777216) % 256, int(n / 65536) % 256, int(n / 256) % 256, n % 256 }'
}

# -----------------------------------------------------------------------
# _unres_lists -- what the "unreserved" target covers, one item a line,
#   sorted: "P <a>-<b>" for each DHCP pool (a dhcp section with an
#   interface, not ignored, dynamic; start and limit as dnsmasq reads them,
#   inside the interface's IPv4 subnet) and "R <ip>" for each address that
#   is not unknown: a static host's ip, a name-only host's current lease
#   (by any of its MACs), the router's own address on that network. One
#   'uci show' and one pass over the lease file, so it is cheap enough for
#   every DHCP lease event.
# -----------------------------------------------------------------------
_unres_lists() {
    local s ifc ign dyn start limit st a ai k
    uci -q show dhcp | awk -v lf=/tmp/dhcp.leases '
        function d(v) { return v == "" ? "-" : v }
        BEGIN { while ((getline l < lf) > 0) { split(l, f, " "); lease[tolower(f[2])] = f[3] } }
        { line = $0; sub(/^dhcp\./, "", line); eq = index(line, "="); k = substr(line, 1, eq - 1); v = substr(line, eq + 1)
          gsub(/\047/, "", v) }
        k !~ /\./ { type[k] = v; next }
        { sec = substr(k, 1, index(k, ".") - 1); opt = substr(k, index(k, ".") + 1); val[sec, opt] = v }
        END {
            for (sec in type) {
                if (type[sec] != "host") continue
                ip = val[sec, "ip"]
                if (ip ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) { print "R " ip; continue }
                n = split(val[sec, "mac"], m, " ")
                for (i = 1; i <= n; i++) if (tolower(m[i]) in lease) print "R " lease[tolower(m[i])]
            }
            # "-" for an option not set, so the fields stay in place for read
            for (sec in type) if (type[sec] == "dhcp")
                print "D", sec, d(val[sec, "interface"]), d(val[sec, "ignore"]), d(val[sec, "dynamicdhcp"]), d(val[sec, "start"]), d(val[sec, "limit"])
        }' | while read -r k s ifc ign dyn start limit; do
            case "$k" in R) echo "R $s"; continue ;; esac
            [ "$ifc" != - ] || continue
            [ "$ign" = 1 ] || [ "$dyn" = 0 ] && continue
            [ "$start" = - ] && start=""; [ "$limit" = - ] && limit=""
            st=$(ubus call "network.interface.$ifc" status 2>/dev/null \
                | jsonfilter -e '@["ipv4-address"][0].address' -e '@["ipv4-address"][0].mask' 2>/dev/null | tr '\n' ' ')
            set -- $st
            [ -n "$2" ] || continue
            ai=$(_ip4_to_int "$1") || continue
            echo "R $1"
            awk -v ip="$ai" -v bits="$2" -v st="${start:-100}" -v lim="${limit:-150}" 'BEGIN {
                size = 2 ^ (32 - bits); net = ip - (ip % size); a = net + st; b = a + lim - 1
                if (b > net + size - 2) b = net + size - 2; if (a <= net) a = net + 1
                if (st ~ /^[0-9]+$/ && lim ~ /^[0-9]+$/ && a <= b) printf "%d %d\n", a, b }' | while read -r a b; do
                echo "P $(_int_to_ip4 "$a")-$(_int_to_ip4 "$b")"
            done
        done | sort -u
}

# _unres_sets <lists file> -- the two sets the unreserved target matches.
_unres_sets() {
    local p r
    p=$(awk '$1 == "P" { printf "%s%s", s, $2; s = ", " }' "$1")
    r=$(awk '$1 == "R" { printf "%s%s", s, $2; s = ", " }' "$1")
    [ -n "$p" ] && p=" elements = { $p };"
    [ -n "$r" ] && r=" elements = { $r };"
    printf '    set %sunres { type ipv4_addr; flags interval; auto-merge;%s }\n' "$OBJ_PREFIX" "$p"
    printf '    set %sres { type ipv4_addr; flags interval; auto-merge;%s }\n' "$OBJ_PREFIX" "$r"
}

# unresync -- after a DHCP lease event or a dhcp config change: rebuild if
#   an enabled rule uses the unreserved target and its lists changed.
unresync() {
    local cur
    [ -f "$NFT_FILE" ] || return 0
    uci -q show "$NAME" | grep -q "\.target=.*'unreserved'" || return 0
    cur=$(_unres_lists)
    [ "$cur" = "$(cat "$UNRES_FILE" 2>/dev/null)" ] && return 0
    start
}

# -----------------------------------------------------------------------
# check_firewall_hook -- make fw4 load our rules with its own (idempotent)
#   fw4 includes every readable /usr/share/nftables.d/table-post/*.nft
#   inside its single ruleset transaction and silently skips unreadable
#   ones, so a symlink to $FW4_BODY (tmpfs, rewritten on every build, absent
#   while stopped) keeps the rules across firewall reloads with no gap.
#   Earlier versions used a fw4 "script" include, which ran only after the
#   reload had already dropped the chain (~1.5 s without rules); remove it.
# -----------------------------------------------------------------------
check_firewall_hook() {
    local sec
    [ -L "$FW4_LINK" ] || { mkdir -p "${FW4_LINK%/*}"; ln -sf "$FW4_BODY" "$FW4_LINK"; }
    for sec in $(uci -q show firewall | sed -n "s/^firewall\.\([^.]*\)\.path='\/usr\/bin\/nft-limiter'$/\1/p"); do
        uci -q delete "firewall.${sec}"
    done
    uci -q changes firewall | grep -q . && uci commit firewall
    return 0
}

# -----------------------------------------------------------------------
# Counter carry-over. Before a rebuild, _snapshot_counters reads the live
# rule counters and per-address accounting sets and files them by row key
# (the row's sorted targets, or "default" for the global limit) and rule
# tag, using the index->key map of the previous build. The new rules then
# start from those values ("counter packets N bytes M"), so totals survive
# rebuilds, reordering and fw4 reloads up to the last build; a reboot or a
# changed target starts from zero.
#   $_carry_file lines:  C <key>|<tag> <packets> <bytes>
#                        S <key>|<set suffix> <elements>
# -----------------------------------------------------------------------
_snapshot_counters() {
    local name idx dir key els
    : > "$_carry_file"
    [ -s "$KEYS_FILE" ] || return 0
    nft list chain inet "$NFT_TABLE" "$NFT_CHAIN" 2>/dev/null | awk -v kf="$KEYS_FILE" '
        BEGIN { FS = "[ \t]+"; while ((getline l < kf) > 0) { split(l, a, "\t"); key[a[1]] = a[2] } }
        / counter packets / && / comment "/ {
            p = b = c = ""
            for (i = 1; i < NF; i++) {
                if ($i == "packets") p = $(i + 1)
                if ($i == "bytes") b = $(i + 1)
                if ($i == "comment") c = $(i + 1)
            }
            gsub(/"/, "", c)
            if (c ~ /^default_/) k = "default|" substr(c, 9)
            else if (match(c, /^dev_[0-9]+_/)) {
                idx = substr(c, 5, RLENGTH - 5)
                if (!(idx in key)) next
                k = key[idx] "|" substr(c, RLENGTH + 1)
            } else next
            P[k] += p; B[k] += b
        }
        END { for (k in P) printf "C\t%s\t%s\t%s\n", k, P[k], B[k] }' >> "$_carry_file"
    # Quota usage, by row key: "quota nftlim_q_<idx> { over N bytes used M bytes }".
    nft list quotas table inet "$NFT_TABLE" 2>/dev/null | tr '\n\t' '  ' | sed 's/}/}\n/g' \
        | awk -v kf="$KEYS_FILE" -v p="${OBJ_PREFIX}q_" '
            BEGIN { while ((getline l < kf) > 0) { split(l, a, "\t"); key[a[1]] = a[2] } }
            { for (i = 1; i < NF; i++) {
                  if ($i == "quota" && index($(i + 1), p) == 1) idx = substr($(i + 1), length(p) + 1)
                  if ($i == "used") u = $(i + 1)
              }
              if (idx != "" && (idx in key)) printf "Q\t%s\t%s\n", key[idx], u + 0
              idx = ""; u = 0 }' >> "$_carry_file"
    # Per-device quotas: "E <row key> <address> <bytes used>".
    for name in $(_list_objects set); do
        case "$name" in "${OBJ_PREFIX}qe_"*) ;; *) continue ;; esac
        key=$(awk -F '\t' -v i="${name#${OBJ_PREFIX}qe_}" '$1 == i { print $2; exit }' "$KEYS_FILE")
        [ -n "$key" ] || continue
        _qe_elements "$name" | awk -v k="$key" '{ printf "E\t%s\t%s\t%s\n", k, $1, $2 }' >> "$_carry_file"
    done
    for name in $(_list_objects set); do
        case "$name" in "${OBJ_PREFIX}acct_"*) ;; *) continue ;; esac
        idx="${name#${OBJ_PREFIX}acct_}"; dir="${idx#*_}"; idx="${idx%%_*}"
        if [ "$idx" = "def" ]; then key="default"; else
            key=$(awk -F '\t' -v i="$idx" '$1 == i { print $2; exit }' "$KEYS_FILE")
            [ -n "$key" ] || continue
        fi
        els=$(nft list set inet "$NFT_TABLE" "$name" 2>/dev/null | tr '\n\t' '  ' \
            | sed -n 's/.*elements = { \([^}]*\) }.*/\1/p' | sed 's/  */ /g; s/ *$//')
        [ -n "$els" ] && printf 'S\t%s|%s\t%s\n' "$key" "$dir" "$els" >> "$_carry_file"
    done
}

# _counter <tag> -- set $_ctr to the counter statement for rule tag <tag>
#   of row $_rowkey: carried values the first time the tag is used in this
#   build (several rules can share a tag; the total goes on the first),
#   else a fresh counter. Sets a variable rather than printing, so it runs
#   in the current shell and $_carried keeps track.
_counter() {
    local k="${_rowkey}|$1" v
    _ctr="counter"
    case "$_carried" in *" $k "*) return ;; esac
    _carried="$_carried $k "
    v=$(awk -F '\t' -v k="$k" '$1 == "C" && $2 == k { print "packets " $3 " bytes " $4; exit }' "$_carry_file")
    _ctr="counter${v:+ $v}"
}

# _acct_set <name> <type> <suffix> -- declare a per-address accounting set
#   (dynamic, one counter per address), seeded with carried elements.
_acct_set() {
    local els
    els=$(awk -F '\t' -v k="${_rowkey}|$3" '$1 == "S" && $2 == k { print $3; exit }' "$_carry_file")
    [ -n "$els" ] && els=" elements = { $els };"
    printf '    set %s { type %s; flags dynamic; counter; size 1024;%s }\n' \
        "$1" "$2" "$els" >> "$_obj_file"
}

# _markset <tag> -- the nft statement that tags a packet for class <tag>,
#   keeping the low 24 bits of the mark (pbr, mwan3 and fw4 use those).
_markset() {
    printf 'meta mark set meta mark & 0x00ffffff | 0x%02x000000' "$1"
}

# -----------------------------------------------------------------------
# _dir_lines <tag> <match> <prefix> <kb> <block> <limit_name>
#   One direction of one device: a drop rule (block), or a limit-over-drop
#   rule plus the terminal pass-through accept (a counter only, no verdict,
#   for a quota-only rule). Comment dev_<tag>[_pass].
# -----------------------------------------------------------------------
_dir_lines() {
    local tag="$1" match="$2" prefix="$3" kb="$4" block="$5" lname="$6"
    local t="${tag#*_}"
    # Per-device quota (quota_each): each address's own quota element, and
    # its own throttle limit element; IPv4 only. Placed first, like the
    # rule's shared quota below.
    if [ -n "$_qe_name" ] && [ "$block" != "1" ]; then
        case "$t" in dl|ul)
            local key="ip daddr" thr=""
            [ "$t" = ul ] && key="ip saddr"
            [ -n "$_q_throttle" ] && thr="update @${OBJ_PREFIX}qel_${tag%%_*}_${t} { $key limit rate over ${_q_rate_kb} kbytes/second burst $(_burst "$_q_rate_kb") kbytes } "
            _counter "${t}_q"
            printf '        %s %supdate @%s { %s quota over %s bytes } %s%s drop comment "dev_%s_q"\n' \
                "$match" "$prefix" "$_qe_name" "$key" "$_qe_bytes" "$thr" "$_ctr" "$tag"
        ;; esac
    fi
    # Quota: a rule that consumes the row's quota and, once it is used up,
    # drops (block) or drops above the throttle rate (throttle). Placed
    # first, so each packet counts against the quota once.
    if [ -n "$_q_name" ] && [ "$block" != "1" ]; then
        if [ -n "$_q_throttle" ] && [ -n "$_qtag" ] && [ "${t#dl}" != "$t" ]; then
            # Shape mode: past the quota, downloads go to the throttle class.
            _counter "${t}_qpass"
            printf '        %s %squota name "%s" %s %s accept comment "dev_%s_qpass"\n' \
                "$match" "$prefix" "$_q_name" "$(_markset "$_qtag")" "$_ctr" "$tag"
        else
            local qlim=""
            [ -n "$_q_throttle" ] && qlim="limit name \"${OBJ_PREFIX}qlim_${tag%%_*}_${t%6}\" "
            _counter "${t}_q"
            printf '        %s %squota name "%s" %s%s drop comment "dev_%s_q"\n' \
                "$match" "$prefix" "$_q_name" "$qlim" "$_ctr" "$tag"
        fi
    fi
    if [ "$block" = "1" ]; then
        _counter "$t"
        printf '        %s %s%s drop comment "dev_%s"\n' "$match" "$prefix" "$_ctr" "$tag"
        return
    fi
    if [ -n "$_stag" ] && [ "${t#dl}" != "$t" ]; then
        # Shape mode download: tag for the rule's class and accept; the
        # pass counter counts what arrived (the class counts delivery).
        _counter "${t}_pass"
        printf '        %s %s%s %s accept comment "dev_%s_pass"\n' \
            "$match" "$prefix" "$(_markset "$_stag")" "$_ctr" "$tag"
        return
    fi
    if [ "$kb" -gt 0 ] 2>/dev/null; then
        # counter after the limit, so it counts only what is dropped.
        _counter "$t"
        printf '        %s %slimit name "%s" %s drop comment "dev_%s"\n' \
            "$match" "$prefix" "$lname" "$_ctr" "$tag"
    fi
    _counter "${t}_pass"
    if [ -n "$_q_only" ]; then
        # Quota only: count what got past the quota and go on, so the rules
        # after this one (a broader rule, else the global limit) still apply.
        printf '        %s %s%s comment "dev_%s_pass"\n' "$match" "$prefix" "$_ctr" "$tag"
        return
    fi
    printf '        %s %s%s accept comment "dev_%s_pass"\n' "$match" "$prefix" "$_ctr" "$tag"
}

# -----------------------------------------------------------------------
# _rule_lines <idx> <target> <dl_kb> <ul_kb> <block> <mac> <time_expr> <day_expr>
#   Outputs nftables rule lines (8-space indent) to stdout. Named limit
#   objects go to $_obj_file and IPv6 address-learning rules to
#   $_learn_file (both emitted ahead of the device rules by build_chain).
#   Uses global $_iface_set for interface scoping.
# -----------------------------------------------------------------------
_rule_lines() {
    local idx="$1" targets="$2" dl_kb="$3" ul_kb="$4" block="$5" macs="$6"
    local time_expr="$7" day_expr="$8"
    local prefix="" kb t v4="" v6="" mac set unres=""
    [ -n "$time_expr" ] && prefix="${time_expr} "
    [ -n "$day_expr"  ] && prefix="${prefix}${day_expr} "
    for t in $targets; do
        case "$t" in
            unreserved) unres=1 ;;
            *:*) v6="${v6:+$v6, }$t" ;;
            *)   v4="${v4:+$v4, }$t" ;;
        esac
    done

    # Shape mode: this rule's download class (tag = index + 1) and, with a
    # throttle quota, its throttle class (tag + 127). Rules past index 126
    # stay policed. A per-device quota throttles each device on its own,
    # policed (a class per device cannot be made on the fly).
    _stag=""; _qtag=""
    if [ "$_shape" = 1 ] && [ "$block" != "1" ] && [ "$idx" -lt 127 ]; then
        if [ "$dl_kb" -gt 0 ] 2>/dev/null; then
            _stag=$(( idx + 1 ))
            echo "$_stag $(( dl_kb * 8 )) $_rowkey" >> "$_tags_new"
        fi
        if [ -n "$_q_throttle" ] && [ -z "$_qe_name" ]; then
            _qtag=$(( idx + 128 ))
            echo "$_qtag $(( _q_rate_kb * 8 )) $_rowkey" >> "$_tags_new"
        fi
    fi

    if [ "$block" != "1" ]; then
        for kb in "dl $dl_kb" "ul $ul_kb"; do
            set -- $kb
            [ "$1" = dl ] && [ -n "$_stag" ] && continue
            [ "$2" -gt 0 ] 2>/dev/null && \
                printf '    limit %s%s_%s { rate over %s kbytes/second burst %s kbytes }\n' \
                    "$OBJ_PREFIX" "$idx" "$1" "$2" "$(_burst "$2")" >> "$_obj_file"
        done
    fi

    # One member matches as itself, several as an anonymous set (nft adds
    # the interval flag itself when ranges or prefixes are present).
    case "$v4" in *,*) v4="{ $v4 }" ;; esac
    case "$v6" in *,*) v6="{ $v6 }" ;; esac

    local in_if="meta iifname { ${_iface_set} }" out_if="meta oifname { ${_iface_set} }"
    local ldl="${OBJ_PREFIX}${idx}_dl" lul="${OBJ_PREFIX}${idx}_ul"
    # Rows covering several addresses (subnet, range, list) also count per
    # address, for the Stats breakdown. No verdict, so placed first.
    local acct="${OBJ_PREFIX}acct_${idx}"
    # The unreserved target: the DHCP pools, less the reserved devices.
    local um_in="$in_if ip daddr @${OBJ_PREFIX}unres ip daddr != @${OBJ_PREFIX}res"
    local um_out="$out_if ip saddr @${OBJ_PREFIX}unres ip saddr != @${OBJ_PREFIX}res"
    case "$v4" in *[,/-]*) ;; *) [ -n "$unres" ] ;; esac && {
        _acct_set "${acct}_dl" ipv4_addr dl; _acct_set "${acct}_ul" ipv4_addr ul
    }
    case "$v4" in *[,/-]*)
        printf '        %s ip daddr %s %supdate @%s_dl { ip daddr } comment "dev_%s_acct"\n' "$in_if" "$v4" "$prefix" "$acct" "$idx"
        printf '        %s ip saddr %s %supdate @%s_ul { ip saddr } comment "dev_%s_acct"\n' "$out_if" "$v4" "$prefix" "$acct" "$idx"
    ;; esac
    if [ -n "$unres" ]; then
        printf '        %s %supdate @%s_dl { ip daddr } comment "dev_%s_acct"\n' "$um_in" "$prefix" "$acct" "$idx"
        printf '        %s %supdate @%s_ul { ip saddr } comment "dev_%s_acct"\n' "$um_out" "$prefix" "$acct" "$idx"
    fi
    case "$v6" in *[,/]*)
        _acct_set "${acct}_dl6" ipv6_addr dl6; _acct_set "${acct}_ul6" ipv6_addr ul6
        printf '        %s ip6 daddr %s %supdate @%s_dl6 { ip6 daddr } comment "dev_%s_acct"\n' "$in_if" "$v6" "$prefix" "$acct" "$idx"
        printf '        %s ip6 saddr %s %supdate @%s_ul6 { ip6 saddr } comment "dev_%s_acct"\n' "$out_if" "$v6" "$prefix" "$acct" "$idx"
    ;; esac
    if [ -n "$v4" ]; then
        _dir_lines "${idx}_dl" "$in_if ip daddr $v4" "$prefix" "$dl_kb" "$block" "$ldl"
        _dir_lines "${idx}_ul" "$out_if ip saddr $v4" "$prefix" "$ul_kb" "$block" "$lul"
    fi
    if [ -n "$unres" ]; then
        _dir_lines "${idx}_dl" "$um_in" "$prefix" "$dl_kb" "$block" "$ldl"
        _dir_lines "${idx}_ul" "$um_out" "$prefix" "$ul_kb" "$block" "$lul"
    fi
    if [ -n "$v6" ]; then
        _dir_lines "${idx}_dl6" "$in_if ip6 daddr $v6" "$prefix" "$dl_kb" "$block" "$ldl"
        _dir_lines "${idx}_ul6" "$out_if ip6 saddr $v6" "$prefix" "$ul_kb" "$block" "$lul"
    fi

    # IPv6 companions for IPv4 hosts with a known MAC: one learned-address
    # set per MAC, all sharing the row's limits.
    [ -n "$macs" ] || return 0
    for mac in $macs; do
        set="${OBJ_PREFIX}v6_$(echo "$mac" | tr -d ':')"
        printf '    set %s { type ipv6_addr; flags dynamic, timeout; timeout 1h; size 64; }\n' \
            "$set" >> "$_obj_file"
        printf '        %s ether saddr %s meta nfproto ipv6 ip6 saddr != fe80::/10 update @%s { ip6 saddr } comment "dev_%s_learn6"\n' \
            "$out_if" "$mac" "$set" "$idx" >> "$_learn_file"
        _dir_lines "${idx}_dl6" "$in_if ip6 daddr @$set" "$prefix" "$dl_kb" "$block" "$ldl"
    done
    local macset
    macset=$(echo $macs | sed 's/ /, /g')
    case "$macset" in *,*) macset="{ $macset }" ;; esac
    _dir_lines "${idx}_ul6" "$out_if ether saddr $macset meta nfproto ipv6" "$prefix" "$ul_kb" "$block" "$lul"
}

# -----------------------------------------------------------------------
# _catch_all_lines <dl_kb> <ul_kb> <time_expr> <day_expr>
#   Outputs catch-all rate limit rules for traffic not matched by any
#   per-device rule.  Uses global $_iface_set.  Must be appended LAST.
#   When time/day exprs are set, the catch-all only applies inside that
#   window; outside it, un-matched traffic is unrestricted.
# -----------------------------------------------------------------------
_catch_all_lines() {
    local dl_kb="$1" ul_kb="$2" time_expr="$3" day_expr="$4"
    local prefix=""
    [ -n "$time_expr" ] && prefix="${time_expr} "
    [ -n "$day_expr"  ] && prefix="${prefix}${day_expr} "

    _rowkey="default"
    # Per-address accounting of the traffic the global limit applies to
    # (the Stats "top talkers" list).
    if [ "$dl_kb" -gt 0 ] 2>/dev/null || [ "$ul_kb" -gt 0 ] 2>/dev/null; then
        local a="${OBJ_PREFIX}acct_def"
        _acct_set "${a}_dl" ipv4_addr dl; _acct_set "${a}_ul" ipv4_addr ul
        _acct_set "${a}_dl6" ipv6_addr dl6; _acct_set "${a}_ul6" ipv6_addr ul6
        printf '        meta iifname { %s } %supdate @%s_dl { ip daddr } comment "default_acct"\n' "$_iface_set" "$prefix" "$a"
        printf '        meta oifname { %s } %supdate @%s_ul { ip saddr } comment "default_acct"\n' "$_iface_set" "$prefix" "$a"
        printf '        meta iifname { %s } %supdate @%s_dl6 { ip6 daddr } comment "default_acct"\n' "$_iface_set" "$prefix" "$a"
        printf '        meta oifname { %s } %supdate @%s_ul6 { ip6 saddr } comment "default_acct"\n' "$_iface_set" "$prefix" "$a"
    fi
    if [ "$dl_kb" -gt 0 ] 2>/dev/null && [ "$_shape" = 1 ]; then
        # Shape mode: tag for the shared default class (255).
        echo "255 $(( dl_kb * 8 )) default" >> "$_tags_new"
        _counter dl_pass
        printf '        meta iifname { %s } %s%s %s comment "default_dl_pass"\n' \
            "$_iface_set" "$prefix" "$(_markset 255)" "$_ctr"
    elif [ "$dl_kb" -gt 0 ] 2>/dev/null; then
        local dl_burst; dl_burst=$(_burst "$dl_kb")
        _counter dl
        printf '        meta iifname { %s } %slimit rate over %s kbytes/second burst %s kbytes %s drop comment "default_dl"\n' \
            "$_iface_set" "$prefix" "$dl_kb" "$dl_burst" "$_ctr"
    fi
    if [ "$ul_kb" -gt 0 ] 2>/dev/null; then
        local ul_burst; ul_burst=$(_burst "$ul_kb")
        _counter ul
        printf '        meta oifname { %s } %slimit rate over %s kbytes/second burst %s kbytes %s drop comment "default_ul"\n' \
            "$_iface_set" "$prefix" "$ul_kb" "$ul_burst" "$_ctr"
    fi
}

# -----------------------------------------------------------------------
# _time_and_day_expr <timestart> <timeend> <week>
#   Sets shell variables _time_expr and _day_expr for use in rules.
# -----------------------------------------------------------------------
_time_and_day_expr() {
    local ts="$1" te="$2" week="$3"
    _time_expr=""
    _day_expr=""

    if [ -n "$ts" ] && [ -n "$te" ]; then
        if [ "$ts" != "00:00" ] || [ "$te" != "00:00" ]; then
            _time_expr="meta hour \"${ts}\"-\"${te}\""
        fi
    fi

    if [ -n "$week" ] && [ "$week" != "0" ]; then
        local nft_days="" d nd
        for d in $(echo "$week" | tr ',' ' '); do
            [ "$d" -eq 7 ] && nd=0 || nd="$d"
            nft_days="${nft_days:+${nft_days}, }${nd}"
        done
        _day_expr="meta day { ${nft_days} }"
    fi
}

# -----------------------------------------------------------------------
# _collect_dev <cfg>  -- config_foreach callback; records
#   "<addr_count> <always> <idx>" for each enabled device with a target into
#   $_order_list. <always> is 0 for a rule with a time window or days and 1
#   for one without: at equal specificity the scheduled rule must come
#   first, since an always-on rule's accept is terminal and would shadow it.
#   Outside its window a scheduled rule doesn't match, so the packet falls
#   through to the next rule for the same address, then broader ones.
#   $_cfg_idx is advanced for every device section (incl. disabled) so the
#   recorded index matches the UCI @device[idx] position (and the
#   dev_<idx> rule comment).
# -----------------------------------------------------------------------
_collect_dev() {
    local cfg="$1" enable target ts te week always=1
    config_get_bool enable "$cfg" enable 1
    if [ "$enable" -eq 0 ]; then
        _cfg_idx=$((_cfg_idx + 1))
        return 0
    fi
    config_get target "$cfg" target
    config_get ts "$cfg" timestart
    config_get te "$cfg" timeend
    config_get week "$cfg" week
    _time_and_day_expr "$ts" "$te" "$week"
    [ -n "$_time_expr$_day_expr" ] && always=0
    # A list's specificity is the total of its members' address counts.
    local t count=0
    for t in $target; do count=$(( count + $(_target_addr_count "$t") )); done
    [ -n "$target" ] && \
        printf '%s\t%s\t%s\n' "$count" "$always" "$_cfg_idx" >> "$_order_list"
    _cfg_idx=$((_cfg_idx + 1))
}

# -----------------------------------------------------------------------
# _emit_device <idx>  -- read UCI @device[idx] and print its rule lines to
#   stdout. Keeps dev_<idx> tied to the original section index.
# -----------------------------------------------------------------------
_emit_device() {
    local idx="$1"
    local target download upload block mac timestart timeend week dl_kb ul_kb t m macs=""
    target=$(uci -q get "${NAME}.@device[${idx}].target")
    [ -z "$target" ] && return 0
    download=$(uci  -q get "${NAME}.@device[${idx}].download")
    upload=$(uci    -q get "${NAME}.@device[${idx}].upload")
    block=$(uci     -q get "${NAME}.@device[${idx}].block")
    mac=$(uci       -q get "${NAME}.@device[${idx}].mac")
    timestart=$(uci -q get "${NAME}.@device[${idx}].timestart")
    timeend=$(uci   -q get "${NAME}.@device[${idx}].timeend")
    week=$(uci      -q get "${NAME}.@device[${idx}].week")
    dl_kb=$(_mbit_to_kb "$download")
    ul_kb=$(_mbit_to_kb "$upload")
    # IPv6 companion rules for the row's single-IPv4 members whose MAC is
    # known: the MACs LuCI saved ('mac' list), plus any resolved now.
    for m in $mac; do
        case " $macs " in *" $m "*) ;; *) macs="${macs:+$macs }$m" ;; esac
    done
    for t in $target; do
        _ip4_to_int "$t" >/dev/null || continue
        m=$(_resolve_mac "$t" "")
        [ -n "$m" ] || continue
        case " $macs " in *" $m "*) ;; *) macs="${macs:+$macs }$m" ;; esac
    done
    _rowkey=$(for t in $target; do echo "$t"; done | sort | tr '\n' ',')
    _rowkey="${_rowkey%,}"
    # Quota (GB per day or per billing period): a quota object seeded with
    # what the row already used this period (live object, else history),
    # plus throttle limits when the action is to slow down, not block.
    local quota qper qact qrate qused qb
    quota=$(uci -q get "${NAME}.@device[${idx}].quota")
    # Quota only (no block, no speeds): the rule adds its quota and nothing
    # else; until the quota is used up the device is left to the rules
    # after it, as if this one were not there, instead of being exempt.
    _q_only=""
    [ "$(uci -q get "${NAME}.@device[${idx}].quota_only")" = 1 ] && [ "${block:-0}" != 1 ] \
        && [ "$dl_kb" = 0 ] && [ "$ul_kb" = 0 ] && _q_only=1
    qper=$(uci -q get "${NAME}.@device[${idx}].quota_period"); qper=${qper:-day}
    qact=$(uci -q get "${NAME}.@device[${idx}].quota_action"); qact=${qact:-block}
    qrate=$(uci -q get "${NAME}.@device[${idx}].quota_rate")
    _q_name=""; _q_throttle=""; _qe_name=""
    qb=$(awk -v g="${quota:-0}" 'BEGIN { printf "%.0f", g * 1000000000 }')
    local cnt=0 els
    for t in $target; do cnt=$(( cnt + $(_target_addr_count "$t") )); done
    if [ "$qb" -gt 0 ] 2>/dev/null && [ "${block:-0}" != 1 ] && [ "$cnt" -gt 1 ] \
            && [ "$(uci -q get "${NAME}.@device[${idx}].quota_each")" = 1 ]; then
        # One quota per address: a dynamic set whose elements carry their own
        # quota, seeded with each address's use this period (live set, else
        # the history's per-address records), plus per-address throttles.
        _qe_name="${OBJ_PREFIX}qe_${idx}"; _qe_bytes=$qb
        els=$(awk -F '\t' -v k="$_rowkey" '$1 == "E" && $2 == k { print $3, $4 }' "$_carry_file")
        [ -n "$els" ] || els=$(_quota_used_addrs "$_rowkey" "$qper")
        els=$(echo "$els" | awk -v q="$qb" 'NF == 2 && $2 > 0 && !seen[$1]++ { printf "%s%s quota over %s bytes used %d bytes", s, $1, q, $2; s = ", " }')
        [ -n "$els" ] && els=" elements = { $els };"
        printf '    set %s { type ipv4_addr; flags dynamic; size 4096;%s }\n' "$_qe_name" "$els" >> "$_obj_file"
        if [ "$qact" = throttle ]; then
            _q_throttle=1
            _q_rate_kb=$(_mbit_to_kb "${qrate:-1}")
            for t in dl ul; do
                printf '    set %sqel_%s_%s { type ipv4_addr; flags dynamic; size 4096; }\n' "$OBJ_PREFIX" "$idx" "$t" >> "$_obj_file"
            done
        fi
    elif [ "$qb" -gt 0 ] 2>/dev/null && [ "${block:-0}" != 1 ]; then
        _q_name="${OBJ_PREFIX}q_${idx}"
        qused=$(awk -F '\t' -v k="$_rowkey" '$1 == "Q" && $2 == k { print $3; exit }' "$_carry_file")
        [ -n "$qused" ] || qused=$(_quota_used "$_rowkey" "$qper")
        printf '    quota %s { over %s bytes used %s bytes }\n' "$_q_name" "$qb" "${qused:-0}" >> "$_obj_file"
        if [ "$qact" = throttle ]; then
            _q_throttle=1
            qrate=$(_mbit_to_kb "${qrate:-1}")
            _q_rate_kb=$qrate
            for t in dl ul; do
                printf '    limit %sqlim_%s_%s { rate over %s kbytes/second burst %s kbytes }\n' \
                    "$OBJ_PREFIX" "$idx" "$t" "$qrate" "$(_burst "$qrate")" >> "$_obj_file"
            done
        fi
    fi
    printf '%s\t%s\n' "$idx" "$_rowkey" >> "${KEYS_FILE}.new"
    _time_and_day_expr "$timestart" "$timeend" "$week"
    _rule_lines "$idx" "$target" "$dl_kb" "$ul_kb" "${block:-0}" "$macs" "$_time_expr" "$_day_expr"
}

# -----------------------------------------------------------------------
# _list_objects <kind> -- echo names of our named objects ("limit" or "set")
#   currently in the fw4 table.
# -----------------------------------------------------------------------
_list_objects() {
    nft list "${1}s" table inet "$NFT_TABLE" 2>/dev/null \
        | awk -v k="$1" -v p="$OBJ_PREFIX" '$1 == k && index($2, p) == 1 { print $2 }'
}

# -----------------------------------------------------------------------
# Shaping (tc). _lan_devs lists the LAN-side devices downloads leave by:
# every static-address interface without a default gateway that is not a
# rate-limited (WAN/tunnel) interface. _tc_apply builds the IFB device's
# HTB tree from $TAGS_FILE and attaches the redirect filters; _tc_attach
# (re)attaches only the filters, for an interface that came back up;
# _tc_teardown removes everything (police mode, stop). Needs kmod-ifb,
# kmod-sched-core (htb, fw, mirred, skbedit, clsact) and tc.
# -----------------------------------------------------------------------
_lan_devs() {
    local i st dev wan
    wan=" $(uci -q get "${NAME}.@${NAME}[0].iface") "
    for i in $(ubus list 'network.interface.*' 2>/dev/null | sed 's/^network\.interface\.//'); do
        case "$wan" in *" $i "*) continue ;; esac
        st=$(ifstatus "$i" 2>/dev/null) || continue
        [ "$(echo "$st" | jsonfilter -e '@.proto')" = static ] || continue
        [ -n "$(echo "$st" | jsonfilter -e '@.route[@.target="0.0.0.0"].nexthop')" ] && continue
        dev=$(echo "$st" | jsonfilter -e '@.l3_device')
        [ -n "$dev" ] && [ "$dev" != lo ] && echo "$dev"
    done | sort -u
}

_tc_attach() {
    local dev tag
    [ -s "$TAGS_FILE" ] || return 0
    for dev in $(_lan_devs); do
        tc qdisc add dev "$dev" clsact 2>/dev/null
        tc filter del dev "$dev" egress prio 49 2>/dev/null
        for tag in $(awk '{ print $1 }' "$TAGS_FILE"); do
            tc filter add dev "$dev" egress prio 49 handle "$(printf '0x%02x000000/%s' "$tag" "$TAG_MASK")" \
                fw action mirred egress redirect dev "$SHAPE_DEV" 2>/dev/null
        done
    done
}

_tc_teardown() {
    local dev
    for dev in $(_lan_devs); do tc filter del dev "$dev" egress prio 49 2>/dev/null; done
    ip link del "$SHAPE_DEV" 2>/dev/null
    rm -f "$TAGS_FILE"
}

# _tc_apply <new tags file> -- returns 1 when shaping is unavailable
#   (no IFB support or no tc), so the caller can fall back to policing.
_tc_apply() {
    local tag kbit hex
    command -v tc >/dev/null || return 1
    ip link show "$SHAPE_DEV" >/dev/null 2>&1 || {
        modprobe ifb 2>/dev/null
        ip link add "$SHAPE_DEV" type ifb 2>/dev/null || return 1
    }
    ip link set "$SHAPE_DEV" up
    tc qdisc del dev "$SHAPE_DEV" root 2>/dev/null
    tc qdisc add dev "$SHAPE_DEV" root handle 1: htb default 0 || return 1
    while read -r tag kbit _; do
        hex=$(printf '%x' "$tag")
        tc class add dev "$SHAPE_DEV" parent 1: classid "1:$hex" htb rate "${kbit}kbit" ceil "${kbit}kbit" quantum 1514
        tc qdisc add dev "$SHAPE_DEV" parent "1:$hex" handle "$hex:" fq_codel
        # Classify by tag, then clear the tag: the shaped packet goes back
        # out its LAN device, and LAN bridges whose port is a VLAN on
        # another LAN bridge (guest, IoT, ... on br-lan) would otherwise
        # send it through the shaper a second time.
        tc filter add dev "$SHAPE_DEV" parent 1: prio 1 handle "$(printf '0x%02x000000/%s' "$tag" "$TAG_MASK")" fw classid "1:$hex" \
            action skbedit mark 0x0/"$TAG_MASK"
    done < "$1"
    mv "$1" "$TAGS_FILE"
    _tc_attach
    # The classes were recreated, so their delivery counters restart at 0:
    # forget their last values so the next snapshot counts from zero.
    [ -f "$HIST_DIR/last.vals" ] && sed -i '/^S|/d' "$HIST_DIR/last.vals"
    return 0
}

# -----------------------------------------------------------------------
# build_chain -- flush and rebuild the complete QoS chain from UCI config
# -----------------------------------------------------------------------
build_chain() {
    _cfg_idx=0
    config_load "$NAME"
    _build_iface_set

    local rules_file="/tmp/nft-limiter-rules.$$" name
    _obj_file="/tmp/nft-limiter-obj.$$"
    _learn_file="/tmp/nft-limiter-learn.$$"
    _carry_file="/tmp/nft-limiter-carry.$$"
    _carried=""
    _tags_new="/tmp/nft-limiter-tags.$$"
    : > "$_tags_new"
    _shape=0
    [ "$(uci -q get "${NAME}.@${NAME}[0].mode")" != police ] && _shape=1
    # Record usage up to now before the rules change.
    snapshot >/dev/null 2>&1
    : > "$rules_file"; : > "$_obj_file"; : > "$_learn_file"; : > "${KEYS_FILE}.new"
    _snapshot_counters

    # Emit device rules most-specific-first (smallest address count) so a
    # per-host rule wins over a broader subnet/range that contains it, and
    # scheduled before always-on at equal specificity (see _collect_dev). The
    # dev_<idx> comment keeps the original UCI section index so the Status
    # view's index mapping stays correct.
    _order_list="/tmp/nft-limiter-order.$$"
    : > "$_order_list"
    _cfg_idx=0
    config_foreach _collect_dev device
    if [ -s "$_order_list" ]; then
        sort -k1,1n -k2,2n -k3,3n "$_order_list" | while read -r _cnt _always _didx; do
            _emit_device "$_didx"
        done >> "$rules_file"
    fi
    rm -f "$_order_list"
    # The unreserved target's two sets, when a rule uses it.
    rm -f "${UNRES_FILE}.new"
    if grep -q "@${OBJ_PREFIX}unres" "$rules_file"; then
        _unres_lists > "${UNRES_FILE}.new"
        _unres_sets "${UNRES_FILE}.new" >> "$_obj_file"
    fi

    local def_glimit def_sched def_dl def_ul def_dl_kb def_ul_kb def_ts def_te def_week
    def_glimit=$(uci -q get "${NAME}.@${NAME}[0].glimit")
    def_dl=$(uci -q get "${NAME}.@${NAME}[0].download")
    def_ul=$(uci -q get "${NAME}.@${NAME}[0].upload")
    def_dl_kb=$(_mbit_to_kb "$def_dl")
    def_ul_kb=$(_mbit_to_kb "$def_ul")
    # Absent flag is treated as enabled so upgrades keep existing global limits.
    [ "${def_glimit:-1}" = "1" ] || { def_dl_kb=0; def_ul_kb=0; }
    def_sched=$(uci -q get "${NAME}.@${NAME}[0].gschedule")
    def_ts=$(uci   -q get "${NAME}.@${NAME}[0].timestart")
    def_te=$(uci   -q get "${NAME}.@${NAME}[0].timeend")
    def_week=$(uci -q get "${NAME}.@${NAME}[0].week")
    # Absent flag is treated as enabled so upgrades keep an existing schedule.
    [ "${def_sched:-1}" = "1" ] || { def_ts="00:00"; def_te="00:00"; def_week="0"; }
    _time_and_day_expr "$def_ts" "$def_te" "$def_week"
    _catch_all_lines "$def_dl_kb" "$def_ul_kb" "$_time_expr" "$_day_expr" >> "$rules_file"

    # The table body: objects, then the chain with its hook. Learning rules
    # go first so they see every packet before any terminal verdict. fw4
    # loads this same file on a firewall reload (check_firewall_hook).
    {
        sort -u "$_obj_file"
        printf 'chain %s {\n' "$NFT_CHAIN"
        printf '    type filter hook forward priority filter - 5; policy accept;\n'
        sort -u "$_learn_file"
        cat "$rules_file"
        printf '}\n'
    } > "${FW4_BODY}.new"
    rm -f "$rules_file" "$_obj_file" "$_learn_file" "$_carry_file"

    # Apply it ourselves in one transaction: ensure the chain exists, flush
    # it, drop our old limit objects (rates may have changed; nothing
    # references them once flushed), then load the body. The old rules stay
    # in force until the whole transaction commits, so there is no gap. IPv6
    # sets are kept so learned addresses survive; redeclaring an identical
    # set is a no-op.
    {
        printf 'table inet %s {\n' "$NFT_TABLE"
        printf '    chain %s {\n' "$NFT_CHAIN"
        printf '        type filter hook forward priority filter - 5; policy accept;\n'
        printf '    }\n}\n'
        printf 'flush chain inet %s %s\n' "$NFT_TABLE" "$NFT_CHAIN"
        for name in $(_list_objects limit); do
            printf 'delete limit inet %s %s\n' "$NFT_TABLE" "$name"
        done
        for name in $(_list_objects quota); do
            printf 'delete quota inet %s %s\n' "$NFT_TABLE" "$name"
        done
        # Accounting sets are recreated with their carried elements.
        for name in $(_list_objects set); do
            case "$name" in "${OBJ_PREFIX}acct_"*)
                printf 'delete set inet %s %s\n' "$NFT_TABLE" "$name" ;;
            esac
        done
        printf 'table inet %s {\n    include "%s"\n}\n' "$NFT_TABLE" "${FW4_BODY}.new"
    } > "$NFT_FILE"
    # Shaping classes go up before the rules that tag packets for them. If
    # shaping is unavailable, rebuild once more in police mode.
    if [ "$_shape" = 1 ]; then
        if ! _tc_apply "$_tags_new"; then
            logger -t nft-limiter "shaping unavailable (needs kmod-ifb, kmod-sched-core, tc); policing instead"
            rm -f "$_tags_new"
            uci -q set "${NAME}.@${NAME}[0].mode=police"
            build_chain; local rc=$?
            uci -q revert "${NAME}.@${NAME}[0].mode"
            return $rc
        fi
    else
        rm -f "$_tags_new"
        _tc_teardown
    fi
    nft -f "$NFT_FILE" || return 1
    mv "${FW4_BODY}.new" "$FW4_BODY"
    mv "${KEYS_FILE}.new" "$KEYS_FILE"
    if [ -f "${UNRES_FILE}.new" ]; then mv "${UNRES_FILE}.new" "$UNRES_FILE"; else rm -f "$UNRES_FILE"; fi
    date +%z > "$TZOFF_FILE"
}

# -----------------------------------------------------------------------
# Main commands
# -----------------------------------------------------------------------
start() {
    # On/off is the service's boot enable (see /etc/init.d/nft-limiter).
    /etc/init.d/nft-limiter enabled || return 0
    check_firewall_hook
    build_chain
}

stop() {
    local name
    # Record and save usage first (this also runs at shutdown).
    snapshot >/dev/null 2>&1
    _hist_save
    nft delete chain inet "${NFT_TABLE}" "${NFT_CHAIN}" 2>/dev/null
    _tc_teardown
    for name in $(_list_objects quota); do
        nft delete quota inet "${NFT_TABLE}" "$name" 2>/dev/null
    done
    for name in $(_list_objects limit); do
        nft delete limit inet "${NFT_TABLE}" "$name" 2>/dev/null
    done
    for name in $(_list_objects set); do
        nft delete set inet "${NFT_TABLE}" "$name" 2>/dev/null
    done
    rm -f "$NFT_FILE" "$TZOFF_FILE" "$FW4_BODY" "$KEYS_FILE" "$UNRES_FILE"
}

status() {
    echo "=== nft-limiter status ==="
    printf 'Enabled : %s\n' "$(/etc/init.d/nft-limiter enabled && echo 1 || echo 0)"
    echo ""
    echo "=== ${NFT_CHAIN} chain ==="
    nft list chain inet "${NFT_TABLE}" "${NFT_CHAIN}" 2>/dev/null || echo "(chain not loaded)"
    echo ""
    echo "=== firewall4 hook ==="
    uci show firewall 2>/dev/null | grep -A4 "nft-limiter" || echo "(no firewall hook)"
}


# -----------------------------------------------------------------------
# History
#
# Every rule's counters are running totals, so usage over a time range
# needs snapshots. "snapshot" (run by the ntp hotplug hook about every
# 11 minutes, before every rebuild, and on stop) reads every value below,
# turns it into a delta against the previous snapshot (a value that went
# down was reset - reboot, Disable, interface restart - so the delta is the
# new value) and files the non-zero deltas in three tiers:
#   fine.log    one line per snapshot, kept HIST_FINE_DAYS
#   hourly.log  one line per local hour, kept HIST_HOURLY_DAYS
#   daily.log   one line per local day, kept HIST_DAILY_DAYS
# Line format: "<epoch> key=bytes key=bytes ...". Hourly/daily lines are
# stamped with the bucket start; fine lines with the snapshot time. Keys:
#   R|<row key>|d|u|dd|ud   row accepted down/up, dropped down/up
#   A|<row key>|<addr>|d|u  per-address traffic of multi-address rows and
#                           of the global limit (row key "default")
#   I|<interface>|rx|tx     bytes through each rate-limited interface
# The whole directory is copied to flash once a day and at shutdown, and
# restored at boot.
# -----------------------------------------------------------------------
_tz_seconds() {
    date +%z | awk '{ s = substr($1, 1, 1); h = substr($1, 2, 2) + 0; m = substr($1, 4, 2) + 0
        o = h * 3600 + m * 60; print (s == "-") ? -o : o }'
}

_collect_values() {
    local name idx dir key i dev f
    nft list chain inet "$NFT_TABLE" "$NFT_CHAIN" 2>/dev/null | awk -v kf="$KEYS_FILE" '
        BEGIN { FS = "[ \t]+"; while ((getline l < kf) > 0) { split(l, a, "\t"); key[a[1]] = a[2] } }
        / counter packets / && / comment "/ {
            b = c = ""
            for (i = 1; i < NF; i++) {
                if ($i == "bytes") b = $(i + 1)
                if ($i == "comment") c = $(i + 1)
            }
            gsub(/"/, "", c)
            if (c == "default_dl") { V["R|default|dd"] += b; next }
            if (c == "default_dl_pass") { V["R|default|d"] += b; next }
            if (c == "default_ul") { V["R|default|ud"] += b; next }
            if (!match(c, /^dev_[0-9]+_/)) next
            idx = substr(c, 5, RLENGTH - 5); t = substr(c, RLENGTH + 1)
            if (!(idx in key)) next
            if (t ~ /^dl6?_(q)?pass$/) {
                s = "d"
                # A download pass that tags no class (a rule with no speed
                # limit, quota-only or not) never reaches the classes of the
                # row, so the waste sum must not expect it there.
                if (!/ mark set /) V["R|" key[idx] "|dn"] += b
            }
            else if (t ~ /^ul6?_(q)?pass$/) s = "u"
            else if (t ~ /^dl/) s = "dd"
            else if (t ~ /^ul/) s = "ud"
            else next
            V["R|" key[idx] "|" s] += b
        }
        END { for (k in V) print k "\t" V[k] }'
    # Every per-address set from one listing (a command chain per set took
    # 0.9 s for 12 sets on an MT7621; this takes 0.3 s).
    nft list sets table inet "$NFT_TABLE" 2>/dev/null | awk -v kf="$KEYS_FILE" -v p="${OBJ_PREFIX}acct_" '
        BEGIN { while ((getline l < kf) > 0) { split(l, a, "\t"); key[a[1]] = a[2] } key["def"] = "default" }
        $1 == "set" { k = ""; if (index($2, p) != 1) next
            idx = substr($2, length(p) + 1); dir = idx; sub(/_.*/, "", idx); sub(/^[^_]*_/, "", dir)
            if (idx in key) { k = key[idx]; d = (dir ~ /^dl/) ? "d" : "u" }
            next }
        k != "" { s = $0
            while (match(s, /[0-9a-fA-F.:]+ counter packets [0-9]+ bytes [0-9]+/)) {
                split(substr(s, RSTART, RLENGTH), f, " "); print "A|" k "|" f[1] "|" d "\t" f[6]
                s = substr(s, RSTART + RLENGTH) } }
        /^[ \t]*}/ { k = "" }'
    # Shape mode: bytes each row's classes delivered (S|<row key>|d).
    if [ -s "$TAGS_FILE" ]; then
        tc -s class show dev "$SHAPE_DEV" 2>/dev/null | awk -v tf="$TAGS_FILE" '
            BEGIN { while ((getline l < tf) > 0) { split(l, a, " "); key[sprintf("1:%x", a[1])] = a[3] } }
            $1 == "class" { cls = $3 }
            # Minus the 14-byte Ethernet header each packet carries at the
            # LAN egress, so it compares with the IP bytes nft counted.
            $1 == "Sent" && (cls in key) { V["S|" key[cls] "|d"] += $2 - 14 * $4 }
            END { for (k in V) print k "\t" V[k] }'
    fi
    local ifs
    ifs=$(uci -q get "${NAME}.@${NAME}[0].iface")
    [ -n "$ifs" ] && ubus call network.interface dump 2>/dev/null \
        | jsonfilter -e '@.interface[*]' 2>/dev/null | awk -v want=" $ifs " '
            { if (!match($0, /"interface": *"[^"]*"/)) next
              i = substr($0, RSTART, RLENGTH); sub(/^"interface": *"/, "", i); sub(/"$/, "", i)
              if (!match($0, /"l3_device": *"[^"]*"/)) next
              dv = substr($0, RSTART, RLENGTH); sub(/^"l3_device": *"/, "", dv); sub(/"$/, "", dv)
              if (index(want, " " i " ")) for (n = 1; n <= 2; n++) {
                  f = "/sys/class/net/" dv "/statistics/" (n == 1 ? "rx" : "tx") "_bytes"
                  if ((getline v < f) > 0) printf "I|%s|%s\t%s\n", i, (n == 1 ? "rx" : "tx"), v
                  close(f) } }'
}

# _acc_add <acc file> <bucket start> <closed log> -- add the delta line on
#   stdin to an open bucket; a bucket from an earlier period is closed
#   (appended to <closed log>) first. Prints 1 if it closed one.
_acc_add() {
    local f="$1" start="$2" log="$3" closed=0
    if [ -s "$f" ] && [ "$(head -n 1 "$f")" != "$start" ]; then
        awk 'NR == 1 { printf "%s", $1; next } { printf " %s=%s", $1, $2 } END { print "" }' "$f" >> "$log"
        rm -f "$f"; closed=1
    fi
    awk -v f="$f" -v start="$start" '
        BEGIN { while ((getline l < f) > 0) { n++; if (n > 1) { split(l, a, " "); A[a[1]] = a[2] } } close(f) }
        { for (i = 2; i <= NF; i++) { split($i, kv, "="); A[kv[1]] += kv[2] } }
        END { print start > f; for (k in A) print k " " A[k] > f }'
    echo "$closed"
}

# _prune <log> <keep seconds> <cut file> <align seconds> -- drop records
#   older than the aligned cut; the cut is recorded so queries know where
#   this tier's coverage starts.
_prune() {
    local log="$1" cut
    cut=$(( $(date +%s) - $2 ))
    cut=$(( cut - (cut + $(_tz_seconds)) % $4 ))
    [ -f "$log" ] || return 0
    awk -v c="$cut" '$1 >= c' "$log" > "$log.new" && mv "$log.new" "$log"
    echo "$cut" > "$3"
}

# With "Save history to flash" off, the history stays in RAM only (lost at
# reboot) and any earlier flash copy is removed.
_hist_save_enabled() {
    [ "$(uci -q get "${NAME}.@${NAME}[0].hist_save")" != 0 ]
}

_hist_save() {
    _hist_save_enabled || { rm -f "$HIST_SAVE"; return 0; }
    [ -d "$HIST_DIR" ] || return 0
    tar -czf "${HIST_SAVE}.new" -C "$HIST_DIR" . 2>/dev/null && mv "${HIST_SAVE}.new" "$HIST_SAVE"
}

_hist_restore() {
    _hist_save_enabled || return 0
    [ -d "$HIST_DIR" ] && return 0
    [ -f "$HIST_SAVE" ] || return 0
    mkdir -p "$HIST_DIR" && tar -xzf "$HIST_SAVE" -C "$HIST_DIR" 2>/dev/null
}

# _delta_line <now> <last.vals> -- read current "key<TAB>value" lines on
#   stdin and print "<now> key=delta ..." for the non-zero deltas (a value
#   that went down was reset, so its delta is the new value). Adds each
#   row's download waste, R|<row key>|w: dropped downloads (dd), plus in
#   shape mode what was sent to its classes but they did not deliver
#   (d - dn - S; dn = downloads passed without a class tag, which go on to
#   a later rule or the global limit). dn is not written to the history.
_delta_line() {
    awk -v now="$1" -v lf="$2" -F '\t' '
        BEGIN { while ((getline l < lf) > 0) { split(l, a, "\t"); last[a[1]] = a[2] } }
        # A key missing from the last snapshot, or one whose counter went
        # down, is a new baseline, not traffic. Counters carry over rebuilds,
        # so a rule that vanished for one snapshot (a stop/start, an upgrade)
        # comes back with its whole total, and a firewall reload re-reads the
        # include file, winding every counter back to its value at the last
        # rebuild. Either way the next delta would be the whole total.
        # S| keys are the exception: _tc_apply drops them on purpose when it
        # recreates the classes, whose counters really do start at 0.
        { c = $2 + 0
          if ($1 !~ /^S\|/ && (!($1 in last) || c < last[$1] + 0)) { P[$1] = 1; next }
          p = ($1 in last) ? last[$1] + 0 : 0; d = (c >= p) ? c - p : c
          D[$1] = d; P[$1] = 1 }
        END {
            for (k in D) {
                if (k !~ /^R\|.*\|(d|dd)$/) continue
                rk = substr(k, 3); sub(/\|(d|dd)$/, "", rk); R[rk] = 1
            }
            # Not clamped per interval: the class counters are read a moment
            # after the nft ones, so d - S jitters around the true value and only
            # sums over a range are meaningful (the UI clamps those at 0).
            for (rk in R) {
                w = D["R|" rk "|dd"] + 0
                # dn new this time (an upgrade, a new row): what part of d
                # went to the classes is unknown, so no class waste yet.
                dn = "R|" rk "|dn"
                if (("S|" rk "|d") in P && !((dn in P) && !(dn in D)))
                    w += D["R|" rk "|d"] - D[dn] - D["S|" rk "|d"]
                if (w != 0) D["R|" rk "|w"] = w
            }
            out = now
            for (k in D) if (k !~ /\|dn$/ && (D[k] > 0 || (k ~ /\|w$/ && D[k] != 0))) out = out " " k "=" D[k]
            print out
        }'
}

snapshot() {
    local now off cur line hs ds closed_h closed_d
    _hist_restore
    mkdir -p "$HIST_DIR"
    now=$(date +%s)
    cur="$HIST_DIR/cur.$$"
    _collect_values > "$cur"
    if [ ! -f "$HIST_DIR/last.vals" ]; then
        mv "$cur" "$HIST_DIR/last.vals"; echo "$now" > "$HIST_DIR/last.ts"
        return 0
    fi
    line=$(_delta_line "$now" "$HIST_DIR/last.vals" < "$cur")
    mv "$cur" "$HIST_DIR/last.vals"; echo "$now" > "$HIST_DIR/last.ts"
    echo "$line" >> "$HIST_DIR/fine.log"
    off=$(_tz_seconds)
    hs=$(( now - (now + off) % 3600 )); ds=$(( now - (now + off) % 86400 ))
    closed_h=$(echo "$line" | _acc_add "$HIST_DIR/hour.acc" "$hs" "$HIST_DIR/hourly.log")
    closed_d=$(echo "$line" | _acc_add "$HIST_DIR/day.acc" "$ds" "$HIST_DIR/daily.log")
    [ "$closed_h" = 1 ] && _prune "$HIST_DIR/fine.log" $(( HIST_FINE_DAYS * 86400 )) "$HIST_DIR/fine.cut" 3600
    if [ "$closed_d" = 1 ]; then
        _prune "$HIST_DIR/hourly.log" $(( HIST_HOURLY_DAYS * 86400 )) "$HIST_DIR/hourly.cut" 86400
        local months
        months=$(uci -q get "${NAME}.@${NAME}[0].hist_months")
        case "$months" in ''|*[!0-9]*) months=0 ;; esac
        [ "$months" -gt 0 ] && HIST_DAILY_DAYS=$(( months * 31 ))
        _prune "$HIST_DIR/daily.log" $(( HIST_DAILY_DAYS * 86400 )) "$HIST_DIR/daily.cut" 86400
        _quota_rollover
        _hist_save
    fi
    return 0
}

# _period_day <year> <month> -- the billing period's start day in that
#   month: period_day (1-31, default 1), or the month's last day when it
#   has fewer days (a period on the 31st starts on 30 April, 28 February).
_period_day() {
    local pd last
    pd=$(uci -q get "${NAME}.@${NAME}[0].period_day"); pd=${pd:-1}
    last=$(awk -v y="$1" -v m="$2" 'BEGIN { split("31 28 31 30 31 30 31 31 30 31 30 31", d, " ")
        n = d[m]; if (m == 2 && ((y % 4 == 0 && y % 100 != 0) || y % 400 == 0)) n = 29; print n }')
    [ "$pd" -gt "$last" ] && pd=$last
    echo "$pd"
}

# _period_start [prev] -- epoch of the current (or previous) billing period
#   start: local midnight of _period_day in the right month.
_period_start() {
    local y m d pd
    y=$(date +%Y); m=$(date +%m); d=$(date +%d)
    m=${m#0}; d=${d#0}
    pd=$(_period_day "$y" "$m")
    [ "$d" -lt "$pd" ] && { m=$(( m - 1 )); [ "$m" -lt 1 ] && { m=12; y=$(( y - 1 )); }; }
    [ "$1" = prev ] && { m=$(( m - 1 )); [ "$m" -lt 1 ] && { m=12; y=$(( y - 1 )); }; }
    date -d "$(printf '%04d-%02d-%02d 00:00' "$y" "$m" "$(_period_day "$y" "$m")")" +%s
}

# _quota_rollover -- at the first snapshot of a new local day, reset the
#   daily quotas, and the billing-period ones when a period starts today.
#   (Up to one snapshot interval, ~11 min, after midnight.)
_quota_rollover() {
    local name idx per pd today m
    m=$(date +%m); pd=$(_period_day "$(date +%Y)" "${m#0}")
    today=$(date +%d); today=${today#0}
    for name in $(_list_objects quota); do
        idx="${name#${OBJ_PREFIX}q_}"
        per=$(uci -q get "${NAME}.@device[${idx}].quota_period")
        if [ "${per:-day}" = day ] || [ "$today" = "$pd" ]; then
            nft reset quota inet "$NFT_TABLE" "$name" >/dev/null 2>&1
        fi
    done
    for name in $(_list_objects set); do
        case "$name" in "${OBJ_PREFIX}qe_"*) ;; *) continue ;; esac
        idx="${name#${OBJ_PREFIX}qe_}"
        per=$(uci -q get "${NAME}.@device[${idx}].quota_period")
        if [ "${per:-day}" = day ] || [ "$today" = "$pd" ]; then
            nft flush set inet "$NFT_TABLE" "$name" >/dev/null 2>&1
        fi
    done
}

# _quota_used <row key> <period> -- bytes the row used since its quota
#   period began (offered traffic, both directions), from the history.
#   Seeds a quota that has no live object (boot, new quota).
_quota_used() {
    local from now off
    now=$(date +%s); off=$(_tz_seconds)
    if [ "$2" = period ]; then from=$(_period_start); else from=$(( now - (now + off) % 86400 )); fi
    _hist_records "$from" | awk -v F="$from" -v rk="R|$1|" '
        $2 >= F { for (j = 3; j <= NF; j++) if (index($j, rk) == 1 && $j !~ /^[^=]*\|w=/) { n = index($j, "="); s += substr($j, n + 1) } }
        END { printf "%d", s }'
}

# _quota_used_addrs <row key> <period> -- "<address> <bytes>" for each
#   address of the row since its quota period began, from the history's
#   per-address records (rows with several addresses keep them). Seeds a
#   per-device quota that has no live set.
_quota_used_addrs() {
    local from now off
    now=$(date +%s); off=$(_tz_seconds)
    if [ "$2" = period ]; then from=$(_period_start); else from=$(( now - (now + off) % 86400 )); fi
    _hist_records "$from" | awk -v F="$from" -v ak="A|$1|" '
        $2 >= F { for (j = 3; j <= NF; j++) if (index($j, ak) == 1) {
            n = index($j, "="); k = substr($j, length(ak) + 1, n - length(ak) - 1); sub(/\|[du]$/, "", k)
            s[k] += substr($j, n + 1) } }
        END { for (a in s) printf "%s %d\n", a, s[a] }'
}

# _qe_elements <set> -- "<address> <bytes used> <quota bytes>" for each
#   element of a per-device quota set (nft prints sizes in whole b/k/m/g).
_qe_elements() {
    nft list set inet "$NFT_TABLE" "$1" 2>/dev/null | tr '\n\t' '  ' \
        | sed -n 's/.*elements = { \([^}]*\) }.*/\1/p' | tr ',' '\n' | awk '
        function b(n, u) { return n * (u ~ /^k/ ? 1024 : u ~ /^m/ ? 1048576 : u ~ /^g/ ? 1073741824 : 1) }
        { a = ""; o = 0; u = 0
          for (i = 1; i <= NF; i++) {
              if ($i ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) a = $i
              if ($i == "over") o = b($(i + 1), $(i + 2))
              if ($i == "used") u = b($(i + 1), $(i + 2))
          }
          if (a != "") printf "%s %.0f %.0f\n", a, u, o }'
}

# _hist_records [from] [to] [hour from] [hour to] -- the history records
#   in [from, to) (+60 s for the 11-minute tier, as history reads it), each
#   prefixed with its tier (86400, 3600, 0): daily before hourly_from, hourly
#   before fine_from, 11-minute after, plus traffic since the last snapshot
#   when <to> is within a minute of now. With an hour span, the closed hourly
#   records in it stand in for the 11-minute lines they sum (the same bytes,
#   a fifth of the lines).
_hist_records() {
    local fc=0 hc=0 F=${1:-0} T=${2:-9999999999} H1=${3:-0} H2=${4:-0}
    [ -f "$HIST_DIR/fine.cut" ] && fc=$(cat "$HIST_DIR/fine.cut")
    [ -f "$HIST_DIR/hourly.cut" ] && hc=$(cat "$HIST_DIR/hourly.cut")
    { [ -f "$HIST_DIR/daily.log" ] && awk -v c="$hc" -v F="$F" -v T="$T" '$1 < c && $1 >= F && $1 < T { print 86400, $0 }' "$HIST_DIR/daily.log"
      [ -f "$HIST_DIR/hourly.log" ] && awk -v c="$fc" -v F="$F" -v T="$T" -v a="$H1" -v b="$H2" \
          '($1 < c || ($1 >= a && $1 < b)) && $1 >= F && $1 < T { print 3600, $0 }' "$HIST_DIR/hourly.log"
      [ -f "$HIST_DIR/fine.log" ] && awk -v F="$F" -v T="$T" -v a="$H1" -v b="$H2" \
          '$1 >= F && $1 < T + 60 && ($1 < a || $1 >= b) { print 0, $0 }' "$HIST_DIR/fine.log"
      if [ -f "$HIST_DIR/last.vals" ] && [ $(( T + 60 )) -gt "$(date +%s)" ]; then
          echo "0 $(_collect_values | _delta_line "$(date +%s)" "$HIST_DIR/last.vals")"
      fi; } 2>/dev/null
}

# history <from|today|yesterday|7d|period|lastperiod> [to] -- JSON for the
#   Stats tab: totals per key over the range, and per-bucket series for the
#   row (R ... d/u) and interface (I ...) keys.
history() {
    local now off t0 from to base range bucket fc hc hs
    now=$(date +%s); off=$(_tz_seconds); t0=$(( now - (now + off) % 86400 ))
    case "$1" in
        today)      from=$t0; to=$now ;;
        yesterday)  from=$(( t0 - 86400 )); to=$t0 ;;
        7d)         from=$(( now - 7 * 86400 )); to=$now ;;
        period)     from=$(_period_start); to=$now ;;
        lastperiod) from=$(_period_start prev); to=$(_period_start) ;;
        *)          from=${1:-$t0}; to=${2:-$now} ;;
    esac
    # Take a snapshot first if the hook has not run lately (no NTP sync).
    if [ -f "$HIST_DIR/last.ts" ] && [ $(( now - $(cat "$HIST_DIR/last.ts") )) -gt 900 ]; then
        snapshot >/dev/null 2>&1
    fi
    fc=0; hc=0
    [ -f "$HIST_DIR/fine.cut" ] && fc=$(cat "$HIST_DIR/fine.cut")
    [ -f "$HIST_DIR/hourly.cut" ] && hc=$(cat "$HIST_DIR/hourly.cut")
    # When recording began (the oldest record kept), so a range that starts
    # earlier can say its data is partial.
    local first
    first=$(for f in daily.log hourly.log fine.log; do [ -s "$HIST_DIR/$f" ] && head -n 1 "$HIST_DIR/$f" | cut -d' ' -f1; done | sort -n | head -n 1)
    base=660
    [ "$from" -lt "$fc" ] && base=3600
    [ "$from" -lt "$hc" ] && base=86400
    # Bars of a whole size (at most 180): 11, 22 or 30 minutes, 1, 2, 3, 6
    # or 12 hours, or whole days. A whole-hour bar reads the closed hourly
    # records inside the range instead of their 11-minute lines.
    range=$(( to - from )); bucket=$(( (range + 179) / 180 ))
    [ "$bucket" -lt "$base" ] && bucket=$base
    for b in 660 1320 1800 3600 7200 10800 21600 43200 86400; do
        [ "$bucket" -le "$b" ] && { bucket=$b; break; }
    done
    [ "$bucket" -gt 86400 ] && bucket=$(( (bucket + 86399) / 86400 * 86400 ))
    local h1=0 h2=0
    if [ $(( bucket % 3600 )) -eq 0 ] && [ -s "$HIST_DIR/hour.acc" ]; then
        h1=$(( from + (3600 - (from + off) % 3600) % 3600 ))   # the first whole hour
        h2=$(( to - (to + off) % 3600 ))                       # the end of the last
        hs=$(head -n 1 "$HIST_DIR/hour.acc")                    # the open hour
        [ "$hs" -lt "$h2" ] && h2=$hs
        [ "$h2" -le "$h1" ] && { h1=0; h2=0; }
    fi
    _hist_records "$from" "$to" "$h1" "$h2" | awk -v F="$from" -v T="$to" -v B="$bucket" -v now="$now" -v fc="$fc" -v hc="$hc" -v first="${first:-0}" '
        { t = $2; if (t < F || t >= T + ($1 == 0 ? 60 : 0)) next
          i = int((t - F) / B)
          # A record in the minute after <to> (an 11-minute one, or the live
          # read) counts in the last bar, as it does in the totals.
          if (i >= int((T - F + B - 1) / B)) i = int((T - F + B - 1) / B) - 1
          split("", hasw); split("", ddv)
          for (j = 3; j <= NF; j++) {
              n = index($j, "="); k = substr($j, 1, n - 1); v = substr($j, n + 1) + 0
              tot[k] += v
              # One test per value, not four regexes: per-address (A) and
              # tc (S) values only add to the totals.
              c = substr(k, 1, 2)
              if (c == "I|") { ser[k, i] += v; sk[k] = 1; continue }
              if (c != "R|") continue
              e = substr(k, n - 2)
              if (e == "|d" || e == "|u") { ser[k, i] += v; sk[k] = 1 }
              else if (e == "|w") hasw[substr(k, 1, n - 3)] = 1
              else if (e == "dd" && substr(k, n - 3, 1) == "|") ddv[substr(k, 1, n - 4)] = v
          }
          # Records from before waste was recorded: dropped downloads are
          # the waste.
          for (r in ddv) if (!(r in hasw)) tot[r "|w"] += ddv[r] }
        END {
            nb = int((T - F + B - 1) / B)
            printf "{\"from\":%d,\"to\":%d,\"now\":%d,\"bucket\":%d,\"fine_from\":%d,\"hourly_from\":%d,\"first\":%d,\"totals\":{", F, T, now, B, fc, hc, first
            sep = ""; for (k in tot) { printf "%s\"%s\":%d", sep, k, tot[k]; sep = "," }
            printf "},\"series\":{"; sep = ""
            for (k in sk) {
                printf "%s\"%s\":[", sep, k; sep = ","
                for (i = 0; i < nb; i++) printf "%s%d", (i ? "," : ""), ser[k, i]
                printf "]"
            }
            print "}}"
        }'
    # Second line: the live quota objects, for the quota bars.
    nft -j list quotas table inet "$NFT_TABLE" 2>/dev/null || echo '{}'
    # Third line: per-device quotas, {"qe":{"<row index>":{"<address>":[used, quota]}}}.
    local name sep="" first
    printf '{"qe":{'
    for name in $(_list_objects set); do
        case "$name" in "${OBJ_PREFIX}qe_"*) ;; *) continue ;; esac
        printf '%s"%s":{' "$sep" "${name#${OBJ_PREFIX}qe_}"; sep=","
        _qe_elements "$name" | awk '{ printf "%s\"%s\":[%s,%s]", s, $1, $2, $3; s = "," }'
        printf '}'
    done
    echo '}}'
}

# stats -- for the LuCI Stats tab, one JSON document per line: the chain
#   (rule counters), then each per-address accounting set.
stats() {
    local name
    nft -j list chain inet "${NFT_TABLE}" "${NFT_CHAIN}" 2>/dev/null || echo null
    nft -j list quotas table inet "${NFT_TABLE}" 2>/dev/null
    # Shape mode: the classes (a JSON array; class 1:<hex tag>).
    [ -s "$TAGS_FILE" ] && tc -s -j class show dev "$SHAPE_DEV" 2>/dev/null
    for name in $(_list_objects set); do
        case "$name" in "${OBJ_PREFIX}acct_"*)
            nft -j list set inet "${NFT_TABLE}" "$name" 2>/dev/null ;;
        esac
    done
}

# Rebuilds and snapshots never overlap: a snapshot taken mid-rebuild reads
# the new index-to-row keys against the old chain (or no chain at all).
# The lock is the open fd, so it goes away with the process.
case "$1" in
    status|stats) ;;
    *) if command -v flock >/dev/null; then exec 9>/var/lock/nft-limiter.lock; flock -x 9; fi ;;
esac

case "$1" in
    start)  start ;;
    stop)   stop ;;
    # Per-device add/del used to patch the chain in place, which broke the
    # specificity order and the shared limit objects. Rebuild instead.
    add|del) start ;;
    status) status ;;
    stats)  stats ;;
    snapshot) snapshot ;;
    tcsync)   _tc_attach ;;
    unresync) unresync ;;
    history)  shift; history "$@" ;;
    *)      start ;;
esac
