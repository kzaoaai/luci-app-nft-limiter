#!/bin/sh /etc/rc.common
#
# nft-limiter init script - nftables/fw4 edition
#

START=99
# STOP makes 'enable' add a shutdown link, so stop runs at shutdown and
# saves the usage history to flash.
STOP=10
USE_PROCD=1

NAME=nft-limiter

# On/off is the service's boot enable (/etc/rc.d/S99nft-limiter), and
# nothing else: System > Startup, Home Assistant's service switch, `rc init`
# and the LuCI Enable/Disable buttons all flip the same thing. Until v3.1.5 a
# UCI flag also had to be 1, so enabling the service from any of those left
# it "on" with no rules loaded.
# Custom verbs driven by the LuCI Status tab service controls. They drive the
# one-shot engine directly rather than procd start/stop, which would emit
# harmless "ubus service delete" noise since this service runs no daemon.
#   on     : enable on boot and load the rules now
#   off    : disable on boot and remove the rules
#   reapply: rebuild the rules now; no-op when disabled
# Every rebuild is one atomic nft transaction (nft-limiter start), never a
# stop followed by a start: stopping first would leave blocked devices with
# internet access for the ~1-2 s the rebuild takes.
EXTRA_COMMANDS="on off reapply"
EXTRA_HELP="        on      Enable the limiter (enable on boot, load rules)
        off     Disable the limiter (disable on boot, remove rules)
        reapply Rebuild the rules now; does nothing while disabled"

on() {
    enable
    nft-limiter start
}

# Disable first, so a hotplug reapply racing this cannot load the rules again.
off() {
    disable
    nft-limiter stop
}

reapply() {
    enabled || return 0
    nft-limiter start
}

# Also what LuCI's apply (ucitrack) and procd's config trigger run, so a
# settings change while disabled must not load the rules.
start_service() {
    if enabled; then
        nft-limiter start
    else
        nft-limiter stop
    fi
}

# rc.common's restart is stop + start; rebuild atomically instead.
restart() {
    start "$@"
}

service_triggers() {
    procd_add_reload_trigger 'nft-limiter'
}

stop_service() {
    nft-limiter stop
}
